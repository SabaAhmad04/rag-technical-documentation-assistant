# ==========================
# LLM Configuration
# ==========================
GROQ_API_KEY=***********************************************

# Model used for Query Rewriting, Document Grading, Answer Generation
GROQ_MODEL=openai/gpt-oss-120b

# ==========================
# Embedding Model
# ==========================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ==========================
# ChromaDB
# ==========================
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=technical_docs

# ==========================
# ==========================
HOST=0.0.0.0
PORT=8000

# ==========================
# Retrieval
# ==========================
TOP_K=5
MAX_RETRIES=2

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO